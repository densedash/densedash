{
  "name": "@densedash/react",
  "version": "0.3.0",
  "description": "densedash React adapter: kernel context, render props, Keymap, Kbd, KbdRange, Footer, Tree, List, Tabs, Table and AppShell.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/densedash/densedash.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "publint": "publint --strict",
    "attw": "attw --pack --profile esm-only"
  },
  "dependencies": {
    "@densedash/core": "workspace:*",
    "@tanstack/table-core": "9.3.1",
    "@tanstack/virtual-core": "3.19.11"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
