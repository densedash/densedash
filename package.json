{
  "name": "densedash",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint --deny-warnings . && oxfmt --check .",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --typecheck",
    "test:types": "vitest run --typecheck.only",
    "type-budget": "node tooling/type-bench/check-budget.mjs",
    "publint": "pnpm --filter './packages/*' -r run publint",
    "attw": "pnpm --filter './packages/*' -r run attw",
    "changeset": "changeset",
    "check-version-plan": "node tooling/check-version-plan.mjs",
    "version-packages": "changeset version && oxfmt --write .",
    "release": "pnpm build && DENSEDASH_PNPM=\"$(command -v pnpm)\" PATH=\"$PWD/tooling/release-bin:$PATH\" changeset publish",
    "test:e2e": "tsc -p e2e/tsconfig.json && playwright test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/get-release-plan": "5.0.2",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "20.8.4",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "publint": "0.3.25",
    "tsdown": "0.23.5",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "pnpm@12.3.4"
}
